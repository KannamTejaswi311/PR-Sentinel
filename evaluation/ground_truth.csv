cal.com,https://github.com/agentic-review-benchmarks/cal.com/pull/16,Types package imports from features,The rule requires that lower-level packages do not import from higher-level packages. The platform types package should not import from the features package as this violates the dependency hierarchy.,packages/platform/types/bookings/2024-08-13/outputs/get-booking-recordings.output.ts,1.0,6.0,"import { ApiProperty } from ""@nestjs/swagger"";
